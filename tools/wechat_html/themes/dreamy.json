{
  "meta": {
    "name": "柔光月夜",
    "desc": "浅色柔光 · cute/dreamy 风格：奶白底、低饱和蓝紫粉、圆润边角"
  },
  "styles": {
    "heading": {"default": "plain", "choices": ["plain", "pill", "number", "bar"]},
    "list":    {"default": "plain", "choices": ["plain", "circle", "square"]},
    "quote":   {"default": "bar",   "choices": ["bar", "quote"]}
  },
  "font": {
    "stack": "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
    "mono": "Consolas,'Courier New',monospace",
    "base_size": 16,
    "line_height": 1.8
  },
  "colors": {
    "blue":      "#8a7fd1",
    "blue_d":    "#6f63b8",
    "coral":     "#f0a6b4",
    "blue_bg":   "#f3eefc",
    "ink":       "#4a4458",
    "ink_d":     "#4a3f6b",
    "ink_h3":    "#6f63b8",
    "ink_h4":    "#8a7fb0",
    "ink_h5":    "#a89ec8",
    "ink_h6":    "#bcb3d6",
    "gray":      "#9a93ab",
    "border":    "#e6def5",
    "quote_bg":  "#f6f1fd",
    "code_bg":   "#4a3f6b",
    "code_fg":   "#f3eefc",
    "code_inline_bg":  "#f3eefc",
    "code_inline_fg":  "#6f63b8",
    "link":      "#8a7fd1",
    "link_border": "#d9cdf0",
    "hr":        "#e6def5",
    "img_border": "#ece6f7",
    "strong":    "#4a3f6b",
    "em":        "#8a7fb0",
    "sup":       "#8a7fd1",
    "bullet":    "#6f63b8",
    "footnote":  "#9a93ab",
    "footer_top":    "#4a3f6b",
    "footer_bottom": "#b9a9ea",
    "footer_text":   "#ffffff",
    "footer_sub":    "#efe9fb"
  },
  "headings": {
    "h1": {"size": 22, "color": "#4a3f6b", "weight": "bold",
           "border_bottom": "3px solid #b9a9ea", "padding_bottom": "10px",
           "margin": "18px 0 14px"},
    "h2": {"size": 19, "color": "#4a3f6b", "weight": "bold",
           "border_left": "4px solid #b9a9ea", "padding_left": "10px",
           "margin": "26px 0 12px"},
    "h3": {"size": 17, "color": "#6f63b8", "weight": "bold",
           "margin": "22px 0 10px"},
    "h4": {"size": 16, "color": "#8a7fb0", "weight": "bold",
           "margin": "16px 0 8px"},
    "h5": {"size": 16, "color": "#a89ec8", "weight": "bold",
           "margin": "14px 0 6px"},
    "h6": {"size": 16, "color": "#bcb3d6", "weight": "bold",
           "margin": "12px 0 6px"}
  },
  "body": {
    "color": "#4a4458",
    "size": 16,
    "line_height": 1.8,
    "margin": "12px 0"
  },
  "blockquote": {
    "bg": "#f6f1fd",
    "border_left": "4px solid #b9a9ea",
    "color": "#8a7fb0",
    "padding": "12px 16px",
    "radius": "0 12px 12px 0",
    "margin": "14px 0",
    "size": 16,
    "line_height": 1.8
  },
  "list": {
    "margin": "6px 0",
    "indent_per_level": 4,
    "bullet_symbol": "•",
    "bullet_size": 20,
    "ordered_size": 18,
    "bullet_color": "#6f63b8",
    "bullet_weight": "bold"
  },
  "table": {
    "header_bg": "#8a7fd1",
    "header_fg": "#ffffff",
    "border": "#e6def5",
    "zebra_bg": "#f3eefc",
    "cell_padding": "8px 8px",
    "header_padding": "9px 8px",
    "cell_size": 16,
    "cell_line_height": 1.6,
    "margin": "14px 0"
  },
  "code": {
    "block_bg": "#4a3f6b",
    "block_fg": "#f3eefc",
    "block_size": 13,
    "block_line_height": 1.6,
    "block_padding": "12px 14px",
    "block_radius": "12px",
    "block_margin": "12px 0",
    "inline_bg": "#f3eefc",
    "inline_fg": "#6f63b8",
    "inline_size": 13,
    "inline_padding": "1px 5px",
    "inline_radius": "6px"
  },
  "image": {
    "border": "1px solid #ece6f7",
    "radius": "12px",
    "max_width": "96%",
    "caption_size": 13,
    "caption_color": "#9a93ab"
  },
  "layout": {
    "max_width": 680,
    "outer_padding": "0 8px"
  }
}
