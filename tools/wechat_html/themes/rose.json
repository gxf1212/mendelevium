{
  "meta": {
    "name": "蔷薇紫",
    "desc": "优雅紫 · 蔷薇色调，优质文章、深度分享"
  },
  "styles": {
    "heading": {
      "default": "plain",
      "choices": [
        "plain",
        "pill",
        "number",
        "bar"
      ]
    },
    "list": {
      "default": "plain",
      "choices": [
        "plain",
        "circle",
        "square"
      ]
    },
    "quote": {
      "default": "bar",
      "choices": [
        "bar",
        "quote"
      ]
    }
  },
  "font": {
    "stack": "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
    "mono": "Consolas,'Courier New',monospace",
    "base_size": 16,
    "line_height": 1.75
  },
  "colors": {
    "blue": "#9B6DB6",
    "blue_d": "#7E549A",
    "coral": "#E58AB0",
    "blue_bg": "#F5EFFA",
    "ink": "#4A4156",
    "ink_d": "#3A3050",
    "ink_h3": "#7E549A",
    "ink_h4": "#9A7FB0",
    "ink_h5": "#B49CC8",
    "ink_h6": "#C6B3D6",
    "gray": "#9A8FA8",
    "border": "#E8DDF0",
    "quote_bg": "#F8F2FB",
    "code_bg": "#3A3050",
    "code_fg": "#F3EDF8",
    "code_inline_bg": "#F5EFFA",
    "code_inline_fg": "#7E549A",
    "link": "#9B6DB6",
    "link_border": "#E0D3EC",
    "hr": "#E8DDF0",
    "img_border": "#ECE4F2",
    "strong": "#3A3050",
    "em": "#9A7FB0",
    "sup": "#9B6DB6",
    "bullet": "#7E549A",
    "footnote": "#9A8FA8",
    "footer_top": "#3A3050",
    "footer_bottom": "#9B6DB6",
    "footer_text": "#ffffff",
    "footer_sub": "#EADEF2"
  },
  "headings": {
    "h1": {
      "size": 22,
      "color": "#3A3050",
      "weight": "bold",
      "border_bottom": "3px solid #9B6DB6",
      "padding_bottom": "10px",
      "margin": "18px 0 14px"
    },
    "h2": {
      "size": 19,
      "color": "#3A3050",
      "weight": "bold",
      "border_left": "4px solid #9B6DB6",
      "padding_left": "10px",
      "margin": "26px 0 12px"
    },
    "h3": {
      "size": 17,
      "color": "#7E549A",
      "weight": "bold",
      "margin": "22px 0 10px"
    },
    "h4": {
      "size": 16,
      "color": "#9A7FB0",
      "weight": "bold",
      "margin": "16px 0 8px"
    },
    "h5": {
      "size": 16,
      "color": "#B49CC8",
      "weight": "bold",
      "margin": "14px 0 6px"
    },
    "h6": {
      "size": 16,
      "color": "#C6B3D6",
      "weight": "bold",
      "margin": "12px 0 6px"
    }
  },
  "body": {
    "color": "#4A4156",
    "size": 16,
    "line_height": 1.75,
    "margin": "12px 0"
  },
  "blockquote": {
    "bg": "#F8F2FB",
    "border_left": "4px solid #9B6DB6",
    "color": "#9A7FB0",
    "padding": "12px 16px",
    "radius": "0 8px 8px 0",
    "margin": "14px 0",
    "size": 16,
    "line_height": 1.75
  },
  "list": {
    "margin": "6px 0",
    "indent_per_level": 4,
    "bullet_symbol": "•",
    "bullet_size": 20,
    "ordered_size": 18,
    "bullet_color": "#7E549A",
    "bullet_weight": "bold"
  },
  "table": {
    "header_bg": "#9B6DB6",
    "header_fg": "#ffffff",
    "border": "#E8DDF0",
    "zebra_bg": "#F5EFFA",
    "cell_padding": "8px 8px",
    "header_padding": "9px 8px",
    "cell_size": 16,
    "cell_line_height": 1.6,
    "margin": "14px 0"
  },
  "code": {
    "block_bg": "#3A3050",
    "block_fg": "#F3EDF8",
    "block_size": 13,
    "block_line_height": 1.6,
    "block_padding": "12px 14px",
    "block_radius": "8px",
    "block_margin": "12px 0",
    "inline_bg": "#F5EFFA",
    "inline_fg": "#7E549A",
    "inline_size": 13,
    "inline_padding": "1px 5px",
    "inline_radius": "4px"
  },
  "image": {
    "border": "1px solid #ECE4F2",
    "radius": "6px",
    "max_width": "96%",
    "caption_size": 13,
    "caption_color": "#9A8FA8"
  },
  "layout": {
    "max_width": 680,
    "outer_padding": "0 8px"
  }
}
