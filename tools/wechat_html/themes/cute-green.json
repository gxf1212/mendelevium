{
  "meta": {
    "name": "萌绿",
    "desc": "清新绿 · 自然系，轻松阅读、科普"
  },
  "styles": {
    "heading": {
      "default": "plain",
      "choices": [
        "plain",
        "pill",
        "number",
        "bar"
      ]
    },
    "list": {
      "default": "plain",
      "choices": [
        "plain",
        "circle",
        "square"
      ]
    },
    "quote": {
      "default": "bar",
      "choices": [
        "bar",
        "quote"
      ]
    }
  },
  "font": {
    "stack": "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
    "mono": "Consolas,'Courier New',monospace",
    "base_size": 16,
    "line_height": 1.75
  },
  "colors": {
    "blue": "#45A97A",
    "blue_d": "#2F8A5F",
    "coral": "#E8935B",
    "blue_bg": "#EAF6F0",
    "ink": "#40504A",
    "ink_d": "#2E4038",
    "ink_h3": "#2F8A5F",
    "ink_h4": "#5A9A7E",
    "ink_h5": "#85B29E",
    "ink_h6": "#A8C6B8",
    "gray": "#8A9892",
    "border": "#D8EAE1",
    "quote_bg": "#F0F8F4",
    "code_bg": "#2E4038",
    "code_fg": "#EDF5F1",
    "code_inline_bg": "#EAF6F0",
    "code_inline_fg": "#2F8A5F",
    "link": "#45A97A",
    "link_border": "#C9E3D6",
    "hr": "#D8EAE1",
    "img_border": "#E3EEE8",
    "strong": "#2E4038",
    "em": "#5A9A7E",
    "sup": "#45A97A",
    "bullet": "#2F8A5F",
    "footnote": "#8A9892",
    "footer_top": "#2E4038",
    "footer_bottom": "#45A97A",
    "footer_text": "#ffffff",
    "footer_sub": "#DCEFE5"
  },
  "headings": {
    "h1": {
      "size": 22,
      "color": "#2E4038",
      "weight": "bold",
      "border_bottom": "3px solid #45A97A",
      "padding_bottom": "10px",
      "margin": "18px 0 14px"
    },
    "h2": {
      "size": 19,
      "color": "#2E4038",
      "weight": "bold",
      "border_left": "4px solid #45A97A",
      "padding_left": "10px",
      "margin": "26px 0 12px"
    },
    "h3": {
      "size": 17,
      "color": "#2F8A5F",
      "weight": "bold",
      "margin": "22px 0 10px"
    },
    "h4": {
      "size": 16,
      "color": "#5A9A7E",
      "weight": "bold",
      "margin": "16px 0 8px"
    },
    "h5": {
      "size": 16,
      "color": "#85B29E",
      "weight": "bold",
      "margin": "14px 0 6px"
    },
    "h6": {
      "size": 16,
      "color": "#A8C6B8",
      "weight": "bold",
      "margin": "12px 0 6px"
    }
  },
  "body": {
    "color": "#40504A",
    "size": 16,
    "line_height": 1.75,
    "margin": "12px 0"
  },
  "blockquote": {
    "bg": "#F0F8F4",
    "border_left": "4px solid #45A97A",
    "color": "#5A9A7E",
    "padding": "12px 16px",
    "radius": "0 8px 8px 0",
    "margin": "14px 0",
    "size": 16,
    "line_height": 1.75
  },
  "list": {
    "margin": "6px 0",
    "indent_per_level": 4,
    "bullet_symbol": "•",
    "bullet_size": 20,
    "ordered_size": 18,
    "bullet_color": "#2F8A5F",
    "bullet_weight": "bold"
  },
  "table": {
    "header_bg": "#45A97A",
    "header_fg": "#ffffff",
    "border": "#D8EAE1",
    "zebra_bg": "#EAF6F0",
    "cell_padding": "8px 8px",
    "header_padding": "9px 8px",
    "cell_size": 16,
    "cell_line_height": 1.6,
    "margin": "14px 0"
  },
  "code": {
    "block_bg": "#2E4038",
    "block_fg": "#EDF5F1",
    "block_size": 13,
    "block_line_height": 1.6,
    "block_padding": "12px 14px",
    "block_radius": "8px",
    "block_margin": "12px 0",
    "inline_bg": "#EAF6F0",
    "inline_fg": "#2F8A5F",
    "inline_size": 13,
    "inline_padding": "1px 5px",
    "inline_radius": "4px"
  },
  "image": {
    "border": "1px solid #E3EEE8",
    "radius": "6px",
    "max_width": "96%",
    "caption_size": 13,
    "caption_color": "#8A9892"
  },
  "layout": {
    "max_width": 680,
    "outer_padding": "0 8px"
  }
}
