{
  "meta": {
    "name": "前端之巅",
    "desc": "青蓝科技 · 前端之巅同款气质，技术分享"
  },
  "styles": {
    "heading": {
      "default": "plain",
      "choices": [
        "plain",
        "pill",
        "number",
        "bar"
      ]
    },
    "list": {
      "default": "plain",
      "choices": [
        "plain",
        "circle",
        "square"
      ]
    },
    "quote": {
      "default": "bar",
      "choices": [
        "bar",
        "quote"
      ]
    }
  },
  "font": {
    "stack": "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
    "mono": "Consolas,'Courier New',monospace",
    "base_size": 16,
    "line_height": 1.75
  },
  "colors": {
    "blue": "#1890C0",
    "blue_d": "#0E7490",
    "coral": "#E07A5F",
    "blue_bg": "#E8F5FA",
    "ink": "#3F4A52",
    "ink_d": "#2A383F",
    "ink_h3": "#0E7490",
    "ink_h4": "#4A8899",
    "ink_h5": "#7AA6B2",
    "ink_h6": "#A0C0C8",
    "gray": "#8A969B",
    "border": "#D6E8EE",
    "quote_bg": "#F0F8FA",
    "code_bg": "#2A383F",
    "code_fg": "#EDF5F7",
    "code_inline_bg": "#E8F5FA",
    "code_inline_fg": "#0E7490",
    "link": "#1890C0",
    "link_border": "#C5E0E8",
    "hr": "#D6E8EE",
    "img_border": "#E2EDF0",
    "strong": "#2A383F",
    "em": "#4A8899",
    "sup": "#1890C0",
    "bullet": "#0E7490",
    "footnote": "#8A969B",
    "footer_top": "#2A383F",
    "footer_bottom": "#1890C0",
    "footer_text": "#ffffff",
    "footer_sub": "#D9EEF3"
  },
  "headings": {
    "h1": {
      "size": 22,
      "color": "#2A383F",
      "weight": "bold",
      "border_bottom": "3px solid #1890C0",
      "padding_bottom": "10px",
      "margin": "18px 0 14px"
    },
    "h2": {
      "size": 19,
      "color": "#2A383F",
      "weight": "bold",
      "border_left": "4px solid #1890C0",
      "padding_left": "10px",
      "margin": "26px 0 12px"
    },
    "h3": {
      "size": 17,
      "color": "#0E7490",
      "weight": "bold",
      "margin": "22px 0 10px"
    },
    "h4": {
      "size": 16,
      "color": "#4A8899",
      "weight": "bold",
      "margin": "16px 0 8px"
    },
    "h5": {
      "size": 16,
      "color": "#7AA6B2",
      "weight": "bold",
      "margin": "14px 0 6px"
    },
    "h6": {
      "size": 16,
      "color": "#A0C0C8",
      "weight": "bold",
      "margin": "12px 0 6px"
    }
  },
  "body": {
    "color": "#3F4A52",
    "size": 16,
    "line_height": 1.75,
    "margin": "12px 0"
  },
  "blockquote": {
    "bg": "#F0F8FA",
    "border_left": "4px solid #1890C0",
    "color": "#4A8899",
    "padding": "12px 16px",
    "radius": "0 8px 8px 0",
    "margin": "14px 0",
    "size": 16,
    "line_height": 1.75
  },
  "list": {
    "margin": "6px 0",
    "indent_per_level": 4,
    "bullet_symbol": "•",
    "bullet_size": 20,
    "ordered_size": 18,
    "bullet_color": "#0E7490",
    "bullet_weight": "bold"
  },
  "table": {
    "header_bg": "#1890C0",
    "header_fg": "#ffffff",
    "border": "#D6E8EE",
    "zebra_bg": "#E8F5FA",
    "cell_padding": "8px 8px",
    "header_padding": "9px 8px",
    "cell_size": 16,
    "cell_line_height": 1.6,
    "margin": "14px 0"
  },
  "code": {
    "block_bg": "#2A383F",
    "block_fg": "#EDF5F7",
    "block_size": 13,
    "block_line_height": 1.6,
    "block_padding": "12px 14px",
    "block_radius": "8px",
    "block_margin": "12px 0",
    "inline_bg": "#E8F5FA",
    "inline_fg": "#0E7490",
    "inline_size": 13,
    "inline_padding": "1px 5px",
    "inline_radius": "4px"
  },
  "image": {
    "border": "1px solid #E2EDF0",
    "radius": "6px",
    "max_width": "96%",
    "caption_size": 13,
    "caption_color": "#8A969B"
  },
  "layout": {
    "max_width": 680,
    "outer_padding": "0 8px"
  }
}
