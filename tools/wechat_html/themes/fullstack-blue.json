{
  "meta": {
    "name": "全栈蓝",
    "desc": "专业蓝 · 全栈技术风，技术文章、教程"
  },
  "styles": {
    "heading": {
      "default": "plain",
      "choices": [
        "plain",
        "pill",
        "number",
        "bar"
      ]
    },
    "list": {
      "default": "plain",
      "choices": [
        "plain",
        "circle",
        "square"
      ]
    },
    "quote": {
      "default": "bar",
      "choices": [
        "bar",
        "quote"
      ]
    }
  },
  "font": {
    "stack": "-apple-system,'Segoe UI','Microsoft YaHei',sans-serif",
    "mono": "Consolas,'Courier New',monospace",
    "base_size": 16,
    "line_height": 1.75
  },
  "colors": {
    "blue": "#2F6FED",
    "blue_d": "#1E55C8",
    "coral": "#E07A5F",
    "blue_bg": "#EBF2FE",
    "ink": "#3F4858",
    "ink_d": "#2C3A55",
    "ink_h3": "#1E55C8",
    "ink_h4": "#4A6FA8",
    "ink_h5": "#7A92BC",
    "ink_h6": "#A0B2D0",
    "gray": "#8A93A3",
    "border": "#D8E4F8",
    "quote_bg": "#F2F7FE",
    "code_bg": "#2C3A55",
    "code_fg": "#EDF2FB",
    "code_inline_bg": "#EBF2FE",
    "code_inline_fg": "#1E55C8",
    "link": "#2F6FED",
    "link_border": "#C9D8F5",
    "hr": "#D8E4F8",
    "img_border": "#E3EAF5",
    "strong": "#2C3A55",
    "em": "#4A6FA8",
    "sup": "#2F6FED",
    "bullet": "#1E55C8",
    "footnote": "#8A93A3",
    "footer_top": "#2C3A55",
    "footer_bottom": "#2F6FED",
    "footer_text": "#ffffff",
    "footer_sub": "#DCE8FB"
  },
  "headings": {
    "h1": {
      "size": 22,
      "color": "#2C3A55",
      "weight": "bold",
      "border_bottom": "3px solid #2F6FED",
      "padding_bottom": "10px",
      "margin": "18px 0 14px"
    },
    "h2": {
      "size": 19,
      "color": "#2C3A55",
      "weight": "bold",
      "border_left": "4px solid #2F6FED",
      "padding_left": "10px",
      "margin": "26px 0 12px"
    },
    "h3": {
      "size": 17,
      "color": "#1E55C8",
      "weight": "bold",
      "margin": "22px 0 10px"
    },
    "h4": {
      "size": 16,
      "color": "#4A6FA8",
      "weight": "bold",
      "margin": "16px 0 8px"
    },
    "h5": {
      "size": 16,
      "color": "#7A92BC",
      "weight": "bold",
      "margin": "14px 0 6px"
    },
    "h6": {
      "size": 16,
      "color": "#A0B2D0",
      "weight": "bold",
      "margin": "12px 0 6px"
    }
  },
  "body": {
    "color": "#3F4858",
    "size": 16,
    "line_height": 1.75,
    "margin": "12px 0"
  },
  "blockquote": {
    "bg": "#F2F7FE",
    "border_left": "4px solid #2F6FED",
    "color": "#4A6FA8",
    "padding": "12px 16px",
    "radius": "0 8px 8px 0",
    "margin": "14px 0",
    "size": 16,
    "line_height": 1.75
  },
  "list": {
    "margin": "6px 0",
    "indent_per_level": 4,
    "bullet_symbol": "•",
    "bullet_size": 20,
    "ordered_size": 18,
    "bullet_color": "#1E55C8",
    "bullet_weight": "bold"
  },
  "table": {
    "header_bg": "#2F6FED",
    "header_fg": "#ffffff",
    "border": "#D8E4F8",
    "zebra_bg": "#EBF2FE",
    "cell_padding": "8px 8px",
    "header_padding": "9px 8px",
    "cell_size": 16,
    "cell_line_height": 1.6,
    "margin": "14px 0"
  },
  "code": {
    "block_bg": "#2C3A55",
    "block_fg": "#EDF2FB",
    "block_size": 13,
    "block_line_height": 1.6,
    "block_padding": "12px 14px",
    "block_radius": "8px",
    "block_margin": "12px 0",
    "inline_bg": "#EBF2FE",
    "inline_fg": "#1E55C8",
    "inline_size": 13,
    "inline_padding": "1px 5px",
    "inline_radius": "4px"
  },
  "image": {
    "border": "1px solid #E3EAF5",
    "radius": "6px",
    "max_width": "96%",
    "caption_size": 13,
    "caption_color": "#8A93A3"
  },
  "layout": {
    "max_width": 680,
    "outer_padding": "0 8px"
  }
}
